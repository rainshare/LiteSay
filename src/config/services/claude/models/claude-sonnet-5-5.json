{
  "id": "claude-sonnet-5-5",
  "label": "Claude Sonnet 5.5",
  "updatedAt": "2026-10-05",
  "sources": [
    "https://platform.claude.com/docs/en/models/overview",
    "https://platform.claude.com/docs/en/about-claude/model-deprecations",
    "https://platform.claude.com/docs/en/build-with-claude/thinking-troubleshooting"
  ],
  "reasoning": {
    "defaultLevel": "off",
    "notice": "services.reasoningBetweenTools",
    "levels": [
      {
        "id": "off",
        "label": "services.reasoningOff",
        "enabled": false,
        "body": {
          "thinking": {
            "type": "between_tools"
          },
          "output_config": {
            "effort": "low"
          }
        }
      },
      {
        "id": "low",
        "label": "services.reasoningLow",
        "enabled": true,
        "body": {
          "thinking": {
            "type": "adaptive"
          },
          "output_config": {
            "effort": "low"
          }
        }
      },
      {
        "id": "medium",
        "label": "services.reasoningMedium",
        "enabled": true,
        "body": {
          "thinking": {
            "type": "adaptive"
          },
          "output_config": {
            "effort": "medium"
          }
        }
      },
      {
        "id": "high",
        "label": "services.reasoningHigh",
        "enabled": true,
        "body": {
          "thinking": {
            "type": "adaptive"
          },
          "output_config": {
            "effort": "high"
          }
        }
      }
    ]
  }
}
