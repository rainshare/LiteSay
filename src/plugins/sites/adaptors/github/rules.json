{
  "id": "github",
  "label": "GitHub",
  "description": "Translate search results, issue and pull request titles, commit messages and times, Markdown, and About. Search filters and sidebar details are optional; controls, repository headers, list metadata, filenames, and topic tags stay unchanged.",
  "domains": ["github.com"],
  "components": ["markdown", "hyperlinks", "rendered-text"],
  "defaultEnabled": true,
  "bodySelector": "main,.markdown-body,.react-directory-commit-message,.react-directory-commit-age,[data-testid=\"latest-commit-html\"],[data-testid=\"latest-commit-details\"],[data-listview-item-title-container] h3",
  "excludedSelector": "nav,footer,[role=\"navigation\"],[role=\"contentinfo\"],#repository-container-header,.pagehead,[class*=\"OverviewHeader-module__\"],[class*=\"OverviewContent-module__Box_1__\"],[aria-labelledby=\"search-filters-title\"],[data-testid=\"facets-pane\"],[data-testid=\"search-sub-header\"],#search-results-count,[data-testid=\"results-list\"] :is([class*=\"footer__\"],h3),.react-directory-filename-column,[data-testid=\"author-avatar\"],[data-testid=\"latest-commit-details\"] a,a[href$=\"/commits\"],a[href*=\"/commits/\"],a[href$=\"/branches\"],a[href$=\"/tags\"],.sr-only,[class*=\"VisuallyHidden\"],time:not(relative-time),relative-time:not(.react-directory-commit-age relative-time):not([data-testid=\"latest-commit-details\"] relative-time),[data-component=\"CounterLabel\"],strong[itemprop=\"name\"],[itemprop=\"author\"],#repository-details-container,.pagehead-actions,a[href*=\"/topics/\"],[class*=\"TopicTagGroup\"],[class*=\"borderGrid__\"] > [class*=\"sidebarSection__\"]:not(:first-child),[class*=\"borderGrid__\"] > [class*=\"sidebarSection__\"] > :not(h2):not([class*=\"description__\"]):not([class*=\"websiteRow__\"]),#search-filters-title,.GlobalNav,#repo-title-component,[data-testid=\"repo-header-actions\"],[data-listview-component=\"items-list\"] > li > :not([data-listview-item-title-container]),[data-listview-item-title-container] > :not(h3)",
  "contentExcludedSelector": "button,[role=\"button\"],.markdown-body a.anchor,a[data-component=\"Button\"],a[data-component=\"Text\"]:has([data-component=\"CounterLabel\"]),[aria-label=\"Filter issues by state\"],[aria-label=\"Filter pull requests by state\"]",
  "renderedTextSelector": ".react-directory-commit-age relative-time,[data-testid=\"latest-commit-details\"] relative-time",
  "inlineLinkSelector": "a[href]",
  "translateInlineLinks": true,
  "preserveMentions": false,
  "preserveEmojiImages": false,
  "sections": [
    {
      "id": "filters",
      "label": "Translate search filters",
      "description": "Search types, languages, and filter names. Off by default; preserve counts.",
      "defaultEnabled": false,
      "bodySelector": "[aria-labelledby=\"search-filters-title\"],[data-testid=\"facets-pane\"],#search-filters-title",
      "excludedSelector": "button,[role=\"button\"],.sr-only,[class*=\"VisuallyHidden\"],[data-component=\"CounterLabel\"],time,relative-time"
    },
    {
      "id": "sidebar-details",
      "label": "Repository sidebar details",
      "description": "Keep README links, licenses, contribution guides, statistics, and releases unchanged by default. The About heading and description are translated.",
      "defaultEnabled": false,
      "bodySelector": "[class*=\"borderGrid__\"]",
      "excludedSelector": "button,[role=\"button\"],.sr-only,[class*=\"VisuallyHidden\"],[data-component=\"CounterLabel\"],a[href*=\"/topics/\"],[class*=\"TopicTagGroup\"],time,relative-time"
    }
  ]
}
